# Copy to .env and fill in. docker compose reads it automatically.

# The address students type to reach LabPulse. Use this computer's IP on the lab network.
# Windows: run `ipconfig` and use the "IPv4 Address" of your Wi-Fi or Ethernet adapter.
PUBLIC_URL=http://192.168.1.20:8080

# Set to true only when LabPulse is behind HTTPS.
COOKIE_SECURE=false

# Invite code instructors must enter to create an account. Set it whenever LabPulse
# is reachable from the internet (for example through a Cloudflare tunnel).
INSTRUCTOR_SIGNUP_CODE=
