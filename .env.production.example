# Copy to .env on the server and fill in every value.

# Your domain, without https://. It must point at this server's IP address.
# No domain? Use the free sslip.io name for your server's IP, e.g. 203-0-113-5.sslip.io
DOMAIN=labpulse.example.com

# Database password. Make it long and random, e.g. the output of: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Instructors need this code to create an account. Share it only with instructors.
INSTRUCTOR_SIGNUP_CODE=change-me-too
